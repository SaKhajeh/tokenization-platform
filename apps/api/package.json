{
  "name": "@tp/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS modular monolith — M-A (auth, orgs, tasks, audit, documents) + M-B (KYB, bank accounts, wallets/digital ID, ledger, deposits)",
  "type": "module",
  "scripts": {
    "build": "npm run build -w @tp/domain --silent && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "node --import @swc-node/register/esm-register src/main.ts",
    "migrate": "node --import @swc-node/register/esm-register src/db/cli.ts migrate",
    "seed:staff": "node --import @swc-node/register/esm-register src/db/cli.ts grant-staff",
    "test": "npm run build -w @tp/domain --silent && vitest run",
    "typecheck": "npm run build -w @tp/domain --silent && tsc -p tsconfig.json --noEmit",
    "worker": "node --import @swc-node/register/esm-register src/worker.ts",
    "start:worker": "node dist/worker.js",
    "test:chain": "CHAIN_IT=1 vitest run test/chain-evm.test.ts",
    "seed:fund": "node --import @swc-node/register/esm-register src/db/cli.ts seed-fund"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "typescript": "~5.6.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@electric-sql/pglite": "^0.5.15",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "ethers": "^6.17.0",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76",
    "@tp/domain": "*"
  }
}
