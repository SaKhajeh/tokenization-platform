# apps/api — copy to .env. Every secret below is REQUIRED when APP_ENV=production.
APP_ENV=development
PORT=3000
DATABASE_URL=postgres://tp:tp_dev_password@localhost:5432/tp

# Secrets (generate with: openssl rand -base64 48 / openssl rand -hex 32)
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
HASH_PEPPER=dev-only-pepper
DATA_ENCRYPTION_KEY=          # 32 bytes, base64 (openssl rand -base64 32); dev uses a fixed key if empty

# Providers: mock in dev, real in staging/prod
SMS_PROVIDER=mock             # mock | jibit
IDENTITY_PROVIDER=mock        # mock | jibit   (also the company registry / IBAN inquiries)
COBANK_PROVIDER=mock          # mock | jibit
CHAIN_PROVIDER=mock           # mock | evm
STORAGE_PROVIDER=memory       # memory (dev) | s3 (MinIO/S3; create the bucket first)

# Jibit
JIBIT_BASE_URL=https://napi.jibit.ir
JIBIT_IDE_API_KEY=
JIBIT_IDE_SECRET=
JIBIT_PULSE_API_KEY=
JIBIT_PULSE_SECRET=
JIBIT_SMS_SENDER=
JIBIT_SMS_OTP_TEMPLATE=
JIBIT_COBANK_API_KEY=
JIBIT_COBANK_SECRET=

# The fund's collection account (connected to Cobank); every deposit lands here
COLLECTION_IBAN=IR000000000000000000000001
COLLECTION_BANK_NAME=
COLLECTION_HOLDER_NAME=صندوق پژوهش و فناوری

KYB_VALIDITY_DAYS=365
BANK_COOLING_OFF_HOURS=24

# Withdrawals (off in production until tested in Jibit's sandbox)
WITHDRAWALS_ENABLED=true
WITHDRAWAL_FUND_APPROVAL_THRESHOLD=10000000000   # rials; at or above → fund manager approval too
SATNA_THRESHOLD=1500000000                       # rials; other-bank transfers at or above go by Satna (RTGS) — confirm
WITHDRAWAL_TRANSFER_REASON=MODIRIAT_NAGHDINEGI   # Jibit transferReason — confirm with Jibit

# Chain (CHAIN_PROVIDER=evm). RPC list as in packages/contracts/.env (dRPC via lb.drpc.org from Iran).
CHAIN_ID=80002
CHAIN_RPC_URLS=https://lb.drpc.org/ogrpc?network=polygon-amoy&dkey=YOUR_DRPC_KEY,https://polygon-amoy.drpc.org,https://polygon-amoy-bor-rpc.publicnode.com
CHAIN_EXPLORER=https://amoy.polygonscan.com
IDENTITY_REGISTRY_ADDRESS=0x7d72E78c129B7BF82Ef78F9327Daf5c3E279fbDC
OPERATOR_PRIVATE_KEY=          # testnet hot key holding REGISTRAR_ROLE; production uses Web3Signer
CHAIN_CONFIRMATIONS=5
CHAIN_TX_STALE_SEC=1800       # re-queue a sent tx with no confirmed receipt after this long (dropped/stuck)
MIN_PRIORITY_FEE_GWEI=30
# Extended PUBLIC key (xpub…) for custodial org addresses. Never put a private key here; the API refuses xprv.
CUSTODY_XPUB=
ORG_ID_SALT=dev-only-org-salt

# Object storage (MinIO in infra/docker-compose.yml)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tp-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

VALIDATE_LEGAL_ID_CHECKSUM=true
