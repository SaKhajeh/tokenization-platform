{
  "name": "@tp/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Shared domain logic: money, Jalali calendar, return engine, state machines, terms hashing",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "jalaali-js": "^1.2.8"
  },
  "devDependencies": {
    "@types/jalaali-js": "^1.2.0",
    "@types/node": "^26.6.6",
    "typescript": "~5.6.3",
    "vitest": "^2.1.9"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "default": "./dist/money.js"
    },
    "./jalali": {
      "types": "./dist/jalali.d.ts",
      "default": "./dist/jalali.js"
    },
    "./returnEngine": {
      "types": "./dist/returnEngine.d.ts",
      "default": "./dist/returnEngine.js"
    },
    "./subscription": {
      "types": "./dist/subscription.d.ts",
      "default": "./dist/subscription.js"
    },
    "./stateMachines": {
      "types": "./dist/stateMachines.d.ts",
      "default": "./dist/stateMachines.js"
    },
    "./pricing": {
      "types": "./dist/pricing.d.ts",
      "default": "./dist/pricing.js"
    },
    "./creditScoring": {
      "types": "./dist/creditScoring.d.ts",
      "default": "./dist/creditScoring.js"
    },
    "./caseFile": {
      "types": "./dist/caseFile.d.ts",
      "default": "./dist/caseFile.js"
    },
    "./support": {
      "types": "./dist/support.d.ts",
      "default": "./dist/support.js"
    }
  }
}
