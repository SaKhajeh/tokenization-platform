{
  "name": "@tp/contracts",
  "version": "0.1.0",
  "description": "Polygon PoS contracts: IdentityRegistry, SeriesFactory, SeriesToken",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "gas": "REPORT_GAS=true hardhat test",
    "deploy:local": "hardhat run scripts/deploy.ts",
    "deploy:amoy": "hardhat run scripts/deploy.ts --network amoy",
    "deploy:polygon": "hardhat run scripts/deploy.ts --network polygon",
    "wallet:new": "hardhat run scripts/wallet-new.ts",
    "rpc:check": "hardhat run scripts/rpc-check.ts --network amoy",
    "rpc:check:polygon": "hardhat run scripts/rpc-check.ts --network polygon",
    "lifecycle:amoy": "hardhat run scripts/lifecycle.ts --network amoy",
    "lifecycle:local": "hardhat run scripts/lifecycle.ts --network localhost",
    "deploy:localhost": "hardhat run scripts/deploy.ts --network localhost",
    "node": "hardhat node"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "hardhat": "^2.29.1",
    "solc": "0.8.24",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "private": true
}
