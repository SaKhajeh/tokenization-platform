# RPC endpoints, comma-separated, in priority order (decision D6: providers with failover; own node optional).
# dkey= is your dRPC API key: keep this file private (it is git-ignored).
# Use dRPC's lb.drpc.org format: the lb.drpc.live address the dashboard shows was unreachable from Iran (2026-11-08).
AMOY_RPC_URLS=https://lb.drpc.org/ogrpc?network=polygon-amoy&dkey=YOUR_DRPC_KEY,https://polygon-amoy.drpc.org,https://polygon-amoy-bor-rpc.publicnode.com
POLYGON_RPC_URLS=https://lb.drpc.org/ogrpc?network=polygon&dkey=YOUR_DRPC_KEY,https://polygon.drpc.org,https://polygon-bor-rpc.publicnode.com,https://polygon.llamarpc.com

# Polygon requires a minimum priority fee; transactions below it are not mined.
MIN_PRIORITY_FEE_GWEI=30

# Created by `npm run wallet:new -w @tp/contracts`. Never share or commit it.
DEPLOYER_PRIVATE_KEY=

# Leave both empty on testnet: the deployer key then takes both roles so the lifecycle test can run.
# Mainnet: Safe multisig (DEFAULT_ADMIN on everything) and the Web3Signer operator key; must differ.
ADMIN_ADDRESS=
OPERATOR_ADDRESS=

REPORT_GAS=false
